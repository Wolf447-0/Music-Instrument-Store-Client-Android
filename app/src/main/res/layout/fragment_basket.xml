<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.BasketFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_basket"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Категории" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/basket_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_basket"
        android:visibility="gone"
        android:layout_margin="8dp"/>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout_basket"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:shimmer_duration="1000"
        app:shimmer_auto_start="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar_basket"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <include
                layout="@layout/basket_product_card_skeleton"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="4dp" />
            <include
                layout="@layout/basket_product_card_skeleton"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="4dp" />
            <include
                layout="@layout/basket_product_card_skeleton"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="4dp" />

            <include
                layout="@layout/basket_product_card_skeleton"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="4dp" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"> <!-- Отступ внутри карточки -->

        <!-- 1. Скелет картинки (высота как у реальной: 180dp) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/skelet" />

        <!-- 2. Скелет названия (как tvProductName) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/skelet" />

        <!-- 3. Скелет категории (как tvProductCategory) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="80dp"
            android:background="@drawable/skelet" />

        <!-- 4. Скелет цены (как tvProductPrice) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="120dp"
            android:background="@drawable/skelet" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph">

    <fragment
        android:id="@+id/auth"
        android:name="com.musicinstrumentstore.fragment.AuthorizationFragment">
        <action
            android:id="@+id/auth_to_reg"
            app:destination="@+id/register"
            />
        <action
            android:id="@+id/auth_to_log_in"
            app:destination="@+id/log_in"
            />
    </fragment>

    <fragment
        android:id="@+id/register"
        android:name="com.musicinstrumentstore.fragment.RegistrationFragment">
        <action
            android:id="@+id/back_to_auth_1"
            app:destination="@+id/auth"
            />
        <action
            android:id="@+id/reg_to_catalog"
            app:destination="@+id/catalog"
            />
    </fragment>


    <fragment
        android:id="@+id/log_in"
        android:name="com.musicinstrumentstore.fragment.LogInFragment">

        <action
            android:id="@+id/back_to_auth_2"
            app:destination="@+id/auth"
            />
        <action
            android:id="@+id/log_in_to_catalog"
            app:destination="@+id/catalog"
            />

    </fragment>

    <fragment
        android:id="@+id/catalog"
        android:name="com.musicinstrumentstore.fragment.CatalogFragment">
        <action
            android:id="@+id/catalog_to_product_card"
            app:destination="@+id/product_card"
            />

    </fragment>

    <fragment
        android:id="@+id/product_card"
        android:name="com.musicinstrumentstore.fragment.ProductCardFragment">

    </fragment>

    <fragment
        android:id="@+id/navigation_category"
        android:name="com.musicinstrumentstore.fragment.CategoryFragment">

        <action
            android:id="@+id/category_to_catalog"
            app:destination="@+id/catalog"
            />

    </fragment>

    <fragment
        android:id="@+id/navigation_basket"
        android:name="com.musicinstrumentstore.fragment.BasketFragment">

    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.musicinstrumentstore.fragment.ProfileFragment">

    </fragment>

</navigation>